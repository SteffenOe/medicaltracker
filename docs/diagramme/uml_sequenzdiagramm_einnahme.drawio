        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam style strictuml\nskinparam sequenceMessageAlign center\nskinparam boxPadding 10\nskinparam participantPadding 10\n\nactor \&quot;Zu pflegende Person\\n(oder Angehörige:r)\&quot; as User\nparticipant \&quot;Webbrowser\\n(Patientensicht)\&quot; as Client\nparticipant \&quot;PatientController\\n(patient_bp)\&quot; as Controller\nparticipant \&quot;Datenbank / ORM\\n(SQLAlchemy)\&quot; as DB\n\nUser -&gt; Client: Klickt auf \&quot;Als eingenommen markieren\&quot;\\n(z. B. Ramipril 5mg, ID: 1)\nactivate Client\n\nClient -&gt; Controller: POST /patient/einnehmen/1\nactivate Controller\n\nController -&gt; DB: EinnahmeProtokoll.query.filter(med_id=1, date=heute).first()\nDB --&gt; Controller: None (noch nicht eingenommen)\n\nalt Erfolgsfall: Atomare Transaktion (GP-03 / FA-06 / FA-07)\n    Controller -&gt; DB: db.session.add(neues_protokoll)\n    Controller -&gt; DB: Medikament.query.get(1)\n    DB --&gt; Controller: medikament_obj\n    \n    note over Controller\n        Bestandsprüfung &amp; Dekrementierung\n        (medikament_obj.bestand -= 1)\n    end note\n    \n    Controller -&gt; DB: db.session.commit()\n    DB --&gt; Controller: SUCCESS\n    \n    note over Controller, Client: Post-Redirect-Get Pattern\n    Controller --&gt; Client: 302 Found (Redirect to /patient/)\n    \n    Client -&gt; Controller: GET /patient/\n    Controller -&gt; DB: Aktualisierten Zustand abfragen\n    DB --&gt; Controller: status_daten\n    Controller --&gt; Client: 200 OK (Aktualisierte Ansicht mit grünem Status)\n    Client --&gt; User: Visuelle Rückmeldung (\&quot;Bereits eingenommen um HH:MM Uhr\&quot;)\n\nelse Fehlerfall / Rollback\n    Controller -&gt; DB: db.session.rollback()\n    DB --&gt; Controller: ROLLBACK OK\n    Controller -&gt; Controller: flash(\&quot;Fehler bei der Verbuchung\&quot;, \&quot;danger\&quot;)\n    Controller --&gt; Client: 302 Found (Redirect to /patient/)\nend\n\ndeactivate Controller\ndeactivate Client\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="l7VAS8fi1rsti-wTgWHv-63">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
