        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome false\nskinparam shadowing false\nskinparam packageBackgroundColor #F8F9FA\nskinparam packageBorderColor #6C757D\nskinparam roundcorner 8\n\npackage \&quot;Data Access Layer (ORM Entities / SQLAlchemy)\&quot; #EBF5FB {\n    class Patient &lt;&lt;entity&gt;&gt; {\n        + id: Integer [PK]\n        + vorname: String(100)\n        + nachname: String(100)\n        + geburtsdatum: Date\n        + notfallkontakt: String(200)\n        --\n        + medikamente: List[Medikament]\n        + vitalwerte: List[Vitalwert]\n        + termine: List[Termin]\n        + einnahmen: List[EinnahmeProtokoll]\n    }\n\n    class Medikament &lt;&lt;entity&gt;&gt; {\n        + id: Integer [PK]\n        + patient_id: Integer [FK]\n        + name: String(150)\n        + dosierung: String(50)\n        + tageszeit: String(20)\n        + bestand: Integer\n        + mindestbestand: Integer\n        --\n        + einnahmen: List[EinnahmeProtokoll]\n        + ist_kritisch(): Boolean\n    }\n\n    class EinnahmeProtokoll &lt;&lt;entity&gt;&gt; {\n        + id: Integer [PK]\n        + patient_id: Integer [FK]\n        + medikament_id: Integer [FK]\n        + soll_tageszeit: String(20)\n        + einnahme_zeitpunkt: DateTime\n        + erledigt: Boolean\n    }\n\n    class Vitalwert &lt;&lt;entity&gt;&gt; {\n        + id: Integer [PK]\n        + patient_id: Integer [FK]\n        + zeitpunkt: DateTime\n        + kategorie: String(50)\n        + wert: Float\n        + einheit: String(20)\n    }\n\n    class Termin &lt;&lt;entity&gt;&gt; {\n        + id: Integer [PK]\n        + patient_id: Integer [FK]\n        + titel: String(200)\n        + kategorie: String(50)\n        + zeitpunkt: DateTime\n        + erledigt: Boolean\n    }\n}\n\npackage \&quot;Business Logic Layer (Validation / WTForms)\&quot; #FEF9E7 {\n    class PatientForm &lt;&lt;form&gt;&gt; {\n        + vorname: StringField\n        + nachname: StringField\n        + geburtsdatum: DateField\n        + notfallkontakt: StringField\n        + submit: SubmitField\n        --\n        + validate_geburtsdatum(field): void\n    }\n\n    class MedikamentForm &lt;&lt;form&gt;&gt; {\n        + name: StringField\n        + dosierung: StringField\n        + tageszeit: SelectField\n        + bestand: IntegerField\n        + mindestbestand: IntegerField\n        + submit: SubmitField\n    }\n\n    class VitalwertForm &lt;&lt;form&gt;&gt; {\n        + kategorie: SelectField\n        + systolisch: FloatField\n        + diastolisch: FloatField\n        + einzelwert: FloatField\n        + submit: SubmitField\n        --\n        + validate(extra_validators): Boolean\n    }\n\n    class TerminForm &lt;&lt;form&gt;&gt; {\n        + titel: StringField\n        + kategorie: SelectField\n        + zeitpunkt: DateTimeLocalField\n        + submit: SubmitField\n    }\n\n    class ReportFilterForm &lt;&lt;form&gt;&gt; {\n        + start_datum: DateField\n        + end_datum: DateField\n        + submit: SubmitField\n        --\n        + validate(extra_validators): Boolean\n    }\n}\n\npackage \&quot;Service Layer\&quot; #EAFAF1 {\n    class PDFGenerator &lt;&lt;service&gt;&gt; {\n        + erstelle_arztbericht_pdf(patient, medikamente, vitalwerte, einnahmen, start, end): BytesIO\n    }\n\n    class NumberedCanvas &lt;&lt;adapter&gt;&gt; {\n        - _saved_page_states: list\n        + showPage(): void\n        + save(): void\n        + draw_page_decorations(page_count): void\n    }\n\n    class TimeUtils &lt;&lt;utility&gt;&gt; {\n        + ZEITFENSTER_ENDE: dict\n        + ist_einnahme_ueberfaellig(tageszeit, eingenommen): Boolean\n    }\n}\n\npackage \&quot;Controller Layer (Flask Blueprints)\&quot; #F4ECF7 {\n    class MainController &lt;&lt;controller&gt;&gt; {\n        + dashboard(): Response\n    }\n\n    class MedikamenteController &lt;&lt;controller&gt;&gt; {\n        + index(): Response\n        + neu(): Response\n        + bearbeiten(id): Response\n        + loeschen(id): Response\n    }\n\n    class PatientController &lt;&lt;controller&gt;&gt; {\n        + tagesansicht(): Response\n        + einnehmen(medikament_id): Response\n        + termin_erledigen(termin_id): Response\n        + profil(): Response\n    }\n\n    class VitaldatenController &lt;&lt;controller&gt;&gt; {\n        + index(): Response\n        + neu(): Response\n    }\n\n    class TermineController &lt;&lt;controller&gt;&gt; {\n        + index(): Response\n        + neu(): Response\n        + bearbeiten(id): Response\n        + toggle(id): Response\n        + loeschen(id): Response\n    }\n\n    class ReportsController &lt;&lt;controller&gt;&gt; {\n        + index(): Response\n    }\n}\n\n&#39; Kardinalitäten und Beziehungen\nPatient \&quot;1\&quot; *-- \&quot;0..*\&quot; Medikament : verwaltet &gt;\nPatient \&quot;1\&quot; *-- \&quot;0..*\&quot; Vitalwert : dokumentiert &gt;\nPatient \&quot;1\&quot; *-- \&quot;0..*\&quot; Termin : plant &gt;\nPatient \&quot;1\&quot; *-- \&quot;0..*\&quot; EinnahmeProtokoll : erfasst &gt;\nMedikament \&quot;1\&quot; o-- \&quot;0..*\&quot; EinnahmeProtokoll : referenziert &lt;\n\n&#39; Abhängigkeiten Controller zu Models und Forms\nMedikamenteController ..&gt; MedikamentForm : nutzt\nMedikamenteController ..&gt; Medikament : modifiziert\nPatientController ..&gt; PatientForm : bindet\nPatientController ..&gt; TimeUtils : verwendet\nPatientController ..&gt; EinnahmeProtokoll : erzeugt\nVitaldatenController ..&gt; VitalwertForm : nutzt\nVitaldatenController ..&gt; Vitalwert : instanziiert\nTermineController ..&gt; TerminForm : nutzt\nTermineController ..&gt; Termin : verwaltet\nReportsController ..&gt; ReportFilterForm : validiert\nReportsController ..&gt; PDFGenerator : beauftragt\nPDFGenerator ..&gt; NumberedCanvas : nutzt zur Paginierung\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AqOG-wTfx9YRfRM930QH-517">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
