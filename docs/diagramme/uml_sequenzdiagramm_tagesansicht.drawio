        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam style strictuml\nskinparam sequenceMessageAlign center\nskinparam boxPadding 10\nskinparam participantPadding 10\n\nactor \&quot;Zu pflegende Person\\n(oder Angehörige:r)\&quot; as User\nparticipant \&quot;Webbrowser\\n(Patientensicht)\&quot; as Client\nparticipant \&quot;PatientController\\n(patient_bp)\&quot; as Controller\nparticipant \&quot;TimeUtils\\n(app/utils)\&quot; as Utils\nparticipant \&quot;Datenbank / ORM\\n(SQLAlchemy)\&quot; as DB\n\nUser -&gt; Client: Klickt auf \&quot;Patientenansicht\&quot;\nactivate Client\n\nClient -&gt; Controller: GET /patient/\nactivate Controller\n\nController -&gt; DB: Patient.query.first()\nDB --&gt; Controller: patient_obj\n\nController -&gt; DB: EinnahmeProtokoll.query.filter(date == heute)\nDB --&gt; Controller: einnahmen_liste\n\nController -&gt; DB: Medikament.query.filter_by(patient_id)\nDB --&gt; Controller: medikamente_liste\n\nloop Für jedes Medikament in medikamente_liste\n    Controller -&gt; Utils: ist_einnahme_ueberfaellig(tageszeit, eingenommen)\n    activate Utils\n    Utils --&gt; Controller: boolean (ueberfaellig)\n    deactivate Utils\nend\n\nController --&gt; Client: 200 OK (Render &#39;patient/tagesansicht.html&#39;)\ndeactivate Controller\n\nClient --&gt; User: Anzeige barrierefreie Tagesansicht\ndeactivate Client\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="l7VAS8fi1rsti-wTgWHv-1">
